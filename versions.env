# containerlab: github.com/srl-labs/containerlab/releases
CONTAINERLAB_VERSION=0.82.0
# kind: github.com/kubernetes-sigs/kind/releases
KIND_VERSION=0.33.0
# same minor as cluster (1.36)
KUBECTL_VERSION=1.36.4
# helm: github.com/helm/helm/releases (Helm 4 = current major)
HELM_VERSION=4.3.1
# cilium-cli: github.com/cilium/cilium-cli/releases
CILIUM_CLI_VERSION=0.20.2
# Cilium github.com/cilium/cilium/releases supports k8s 1.33–1.36
CILIUM_VERSION=1.20.4
# FRR: quay.io/repository/frrouting/frr?tab=tags (10.7.1 = newest stable, pinned by digest)
FRR_IMAGE=quay.io/frrouting/frr:10.7.1@sha256:e995beaa50fdc9edb35eadcfefa29b7f062cc06f2b812613789b68fa541554d2
# k8s 1.36 = newest within Cilium 1.20 range (1.37 is not supported) — from kind v0.33.0 release notes
KIND_NODE_IMAGE=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed
# Netshoot hub.docker.com/r/nicolaka/netshoot/tags
CLIENT_IMAGE=nicolaka/netshoot:v0.16@sha256:b09d9b21381f47a79b3cbcb30da25266dc17186ea00ae65e99fdc51396f48e70
